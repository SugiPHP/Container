{
    "name": "sugiphp/container",
    "description": "PSR-11 compatible dependency injection container",
    "type": "library",
    "version": "3.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Plamen Popov",
            "email": "tzappa@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "SugiPHP\\Container\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugiPHP\\Container\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
